{
  "name": "make-dinner",
  "version": "0.0.0",
  "description": "A build system stitched onto a kitchen: one schedule in which every dish lands hot at the same time.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run --project examples",
    "test:props": "vitest run --project props --passWithNoTests",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.core.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.mcp.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build": "tsc -p tsconfig.core.json && tsc -p tsconfig.server.json && tsc -p tsconfig.mcp.json && tsx scripts/build-web.ts",
    "dev": "tsx scripts/build-web.ts --watch & tsx watch src/server/index.ts",
    "start": "node dist/server/index.js",
    "check:contrast": "tsx scripts/check-contrast.ts",
    "record": "tsx scripts/record.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@hono/node-server": "2.1.6",
    "@modelcontextprotocol/sdk": "1.32.2",
    "hono": "4.13.17",
    "preact": "11.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.60.0",
    "@types/node": "22.20.5",
    "@vitest/eslint-plugin": "1.6.28",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-plugin-import-x": "4.18.1",
    "fast-check": "4.10.2",
    "playwright-core": "1.60.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
