# Model key. Leave empty to run with the built-in samples and Dinnerfile import only.
ANTHROPIC_API_KEY=

# Listen port (Render sets it).
PORT=3000

# Model calls per IP per window, and the window in seconds.
PARSE_RATE_PER_IP=5
PARSE_RATE_WINDOW_SEC=600

# Model calls per UTC day, all clients.
PARSE_DAILY_CAP=200

# Timeout of one model request attempt, in milliseconds.
PARSE_TIMEOUT_MS=60000

# Read the client IP from X-Forwarded-For. Render: true.
TRUST_PROXY=false

# debug, info, warn or error.
LOG_LEVEL=info
